# ═══════════════════════════════════════════════════════════════
# TRAVELOS WEBSITE — Environment Variables
# Copy to .env.local and fill in real values
# NEVER commit .env.local or actual secrets
# ═══════════════════════════════════════════════════════════════

# Public site origin (browser-safe)
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Public CRM origin for any staff/CRM links rendered by the website
NEXT_PUBLIC_CRM_URL=http://localhost:3001

# Server-only: Website → CRM HTTP (contact form lead ingestion)
# Do not expose this as NEXT_PUBLIC
CRM_INTERNAL_URL=http://localhost:3001
